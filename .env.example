# Neon: copy the PostgreSQL URL from Project > Connect into your local .env.
# For initial local QA/schema setup, use a dedicated test branch and direct connection.
DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production requires the real HTTPS origin and a randomly generated secret.
# SMTP powers password resets, student confirmations, and team notifications.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
NOTIFY_EMAIL=
# Comma-separated explicit hosts for remote website images (no protocol/wildcards).
IMAGE_HOSTS=
# Optional public PNG logo for email templates.
EMAIL_LOGO_URL=
# Reserved integrations below are not currently wired into the application.
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_ZONE_ID=
SENTRY_DSN=

DATABASE_SCHEMA=gap
# Opt in only while developing collection schemas; normally run npm run cms:sync.
PAYLOAD_PUSH_SCHEMA=false
# Optional: log actual public CMS cache misses while measuring performance.
CMS_CACHE_DEBUG=false
